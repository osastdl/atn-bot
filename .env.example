# Copy to .env for local testing. Never commit the real .env — it's gitignored.
# In production, these live as GitHub Actions repo secrets, not in a file.

TELEGRAM_BOT_TOKEN=
# Chat that sent /start first -- captured 2026-08-18 from @DameZsaZsa.
ATN_TELEGRAM_CHAT_ID=

# Phase 1 + 2 notifications -- ZAF Consultancy Portal (Supabase)
# ATN_BOT_EMAIL/PASSWORD is a dedicated org_member login for the African
# Trans Network org, NOT a service-role key -- normal RLS restricts it to
# ATN's own rows, same as any other org's user. Created via the portal's
# own /admin/invites flow, not by Claude.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ATN_BOT_EMAIL=
ATN_BOT_PASSWORD=
ATN_ORG_ID=

# Phase 3 — personal Facebook/Instagram (fresh creds, unrelated to ATN)
PERSONAL_IG_ACCESS_TOKEN=
PERSONAL_IG_USER_ID=
PERSONAL_FB_PAGE_ID=
PERSONAL_FB_PAGE_TOKEN=

# Phase 3 — ZAF Consultancy website gallery
ZAF_GALLERY_API_URL=
ZAF_GALLERY_API_KEY=

# Email — zsazsa@zafconsultancy.org
EMAIL_ADDRESS=zsazsa@zafconsultancy.org
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=mail.zafconsultancy.org
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail.zafconsultancy.org
EMAIL_SMTP_PORT=465
